# Copy to .env.local and fill in. Never commit .env.local.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.

# ---------------------------------------------------------------------------
# Upstream backend (server-only). The browser never sees this URL.
# ---------------------------------------------------------------------------
BACKEND_API_URL=https://<your-backend>.vercel.app/api/v1
# Required. Same value as the backend's BFF_SECRET; it refuses calls without it.
# Generate with: openssl rand -base64 48
BFF_SECRET=
# Per-request timeout when the proxy calls the backend, in milliseconds.
BACKEND_API_TIMEOUT_MS=10000
# Retries for idempotent requests (GET/HEAD/PUT/DELETE) on network errors and 502/503/504.
BACKEND_API_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Optional. If set, the JWT signature issued by the backend is verified in middleware.
# If unset, the token is only decoded and checked for expiry and role.
JWT_SECRET=
# Cookie name for the session token.
AUTH_COOKIE_NAME=access_token

# ---------------------------------------------------------------------------
# Redis (server-only). Optional: when unset or unreachable the app runs without
# caching and rate limiting, logging a warning.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Namespace prefix for every key this app writes.
REDIS_KEY_PREFIX=khalamma:v1
# Cache TTLs in seconds.
CACHE_TTL_CATALOG=600
CACHE_TTL_PRODUCT_LIST=60
CACHE_TTL_PRODUCT=300
CACHE_TTL_BANNER=600
# Rate limits, requests per 60-second window per client IP.
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_WRITE=30
RATE_LIMIT_AUTH=10

# ---------------------------------------------------------------------------
# CORS: comma-separated list of origins allowed to call /api/* cross-origin.
# Same-origin requests from this app are always allowed.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:4000

# ---------------------------------------------------------------------------
# Cloudinary (server-only). Uploads go through /api/uploads.
# If API_KEY and API_SECRET are set, uploads are signed.
# Otherwise the unsigned UPLOAD_PRESET is used, still from the server.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=dzmhtdw6b
CLOUDINARY_UPLOAD_PRESET=LeatherForLuxury
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Max upload size in megabytes.
UPLOAD_MAX_MB=25

# ---------------------------------------------------------------------------
# Public (bundled into the browser).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Tithi
NEXT_PUBLIC_APP_URL=http://localhost:4000
# Comma-separated hostnames allowed for next/image remote images.
NEXT_PUBLIC_IMAGE_HOSTS=res.cloudinary.com

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
